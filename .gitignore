# Salidas de build de Rojo
build/
*.rbxl
*.rbxlx
*.rbxm

# Dependencias de Wally y lockfiles
Packages/
*.lock

# Sistema operativo
.DS_Store

# Secretos: nunca deben llegar al repo (claves, tokens, webhooks, cookies).
# Van en variables de entorno o en los Secrets de Roblox (CLAUDE.md).
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.secret
secrets*
*secrets*.json
credentials*.json
*.ROBLOSECURITY
cookies*.txt

# Modelos de origen pesados (exportaciones de Meshy u otros generadores).
# Se conservan en disco; al repo solo van el .fbx final y sus texturas.
assets/blender/*_meshy/
assets/blender/*_meshy.fbx
Meshy_AI_*/

# Los modelos de los monstruos (Model guardado desde Studio) sí van: Rojo los pone en ServerStorage.
!assets/modelos/*.rbxm
# Exportaciones descartadas (acostadas o de prueba) y salidas de Cowork.
assets/_descartados/
Claude outputs/
.claude/*
!.claude/agents/
*.fbm/

# Caché de Python de tools/
__pycache__/

# Copias de respaldo automáticas de Blender
*.blend1

# Fotos y videos de referencia del usuario: pesados y personales, viven solo en disco.
referencias/
