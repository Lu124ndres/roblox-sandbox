# Salidas de build de Rojo
build/
*.rbxl
*.rbxlx
*.rbxm

# Dependencias de Wally y lockfiles
Packages/
*.lock

# Sistema operativo
.DS_Store

# Secretos: nunca deben llegar al repo
.env
*.key
credentials.json

# Modelos de origen pesados (exportaciones de Meshy u otros generadores).
# Se conservan en disco; al repo solo van el .fbx final y sus texturas.
assets/blender/*_meshy/
assets/blender/*_meshy.fbx
Meshy_AI_*/

# Los modelos de los monstruos (Model guardado desde Studio) sí van: Rojo los pone en ServerStorage.
!assets/modelos/*.rbxm
# Exportaciones descartadas (acostadas o de prueba) y salidas de Cowork.
assets/_descartados/
Claude outputs/
.claude/
*.fbm/

# Caché de Python de tools/
__pycache__/

# Copias de respaldo automáticas de Blender
*.blend1
